# VPS public IPv4, IPv6, or domain used in Clash subscriptions.
# Example: PUBLIC_HOST=203.0.113.10
PUBLIC_HOST=

# Optional: external TCP forwarding host and port for the proxy.
# Set these if your platform maps container port 7928 to a different public host/port.
PUBLIC_PROXY_HOST=
PUBLIC_PROXY_PORT=

# Host ports exposed by docker compose.
UI_PORT=8787
PROXY_PORT=7928

TZ=Asia/Shanghai
TARGET_VALID_NODES=3
MAX_SCAN_ROWS=300
FETCH_INTERVAL_SECONDS=1260
CHECK_INTERVAL_SECONDS=1260
